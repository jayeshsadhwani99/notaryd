# Local defaults match docker-compose.yml. Point DATABASE_URL at Supabase
# when you have a project — the engine talks to Postgres directly, not the Data API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notaryd
REDIS_URL=redis://127.0.0.1:6379

# 32-byte hex, or any long passphrase. Required in production.
VAULT_KEY=dev-only-vault-key-change-me

# Engine
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATA_DIR=./.data
# Set false on an API-only process if you split workers later.
RUN_WORKER=true

# Web (defaults to http://127.0.0.1:4000)
ENGINE_URL=http://127.0.0.1:4000

# Optional integrations. The dashboard and code review work without these.
E2B_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional private bucket for screenshots. Without these, evidence stays on local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Must be true before Notaryd will wipe sandbox rows for clean-slate accounts.
NOTARYD_ALLOW_DATA_RESET=false
